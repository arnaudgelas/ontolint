# A generated data module: individuals of the core classes.
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix ex: <https://example.test/onto/core#> .

<https://example.test/onto/data> a owl:Ontology ;
    owl:imports <https://example.test/onto/core> , <https://example.test/onto/meta> .

ex:DesignNote a ex:Document ; rdfs:label "design note"@en .
