# The terms, in the namespace every module shares.
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix ex: <https://example.test/onto/core#> .

<https://example.test/onto/core> a owl:Ontology ; owl:imports <https://example.test/onto/meta> .

ex:Document a owl:Class ;
    rdfs:label "document"@en ;
    skos:definition "A standing artefact assembled from the work."@en .

ex:UndefinedThing a owl:Class ;
    rdfs:label "undefined thing"@en .
