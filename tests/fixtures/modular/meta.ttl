# Shared annotation vocabulary; imported by the umbrella and by core (a diamond), and imports the
# umbrella back (a cycle).
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix ex: <https://example.test/onto/core#> .

<https://example.test/onto/meta> a owl:Ontology ; owl:imports <https://example.test/onto> .

ex:status a owl:AnnotationProperty ;
    rdfs:label "status"@en ;
    skos:definition "How firmly the sources support a term."@en .

ex:Status a owl:Class ;
    rdfs:label "status value"@en ;
    skos:definition "A value of ex:status."@en .

ex:Authoritative a ex:Status ;
    rdfs:label "authoritative"@en ;
    skos:definition "Stated by the current contract."@en .
