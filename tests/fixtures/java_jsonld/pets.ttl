@prefix : <https://example.test/pets#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://example.test/pets> a owl:Ontology ;
    rdfs:label "Pets"@en .

:Animal a owl:Class ;
    rdfs:label "animal"@en , "animal"@fr ;
    skos:definition "A living organism that moves."@en .

:Pet a owl:Class ;
    rdfs:subClassOf :Animal ,
        [ a owl:Restriction ; owl:onProperty :hasOwner ; owl:someValuesFrom :Person ] .

:Person a owl:Class ;
    rdfs:label "person"@en .

:Dog a owl:Class ;
    rdfs:subClassOf :Pet ;
    rdfs:label "dog"@en .

:hasOwner a owl:ObjectProperty ;
    rdfs:domain :Pet ;
    rdfs:range :Person .

:age a owl:DatatypeProperty ;
    rdfs:range xsd:nonNegativeInteger .
