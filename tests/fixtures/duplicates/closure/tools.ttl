# Copied from food.ttl: the header still names the food module.
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<https://example.test/kitchen/food> a owl:Ontology .

<https://example.test/kitchen#Knife> a owl:Class ;
    rdfs:label "knife"@en .
