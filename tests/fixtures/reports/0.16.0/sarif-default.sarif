              "name": "METRIC011",
              "shortDescription": {
                "text": "Excessive number of imports"
              },
              "fullDescription": {
                "text": "Excessive number of imports. Reduce owl:imports to the ontologies actually needed, or use import modules."
              },
              "help": {
                "text": "Reduce owl:imports to the ontologies actually needed, or use import modules."
              },
