              "id": "SHQ003",
              "name": "SHQ003",
              "shortDescription": {
                "text": "Constraint-bearing shape without sh:message"
              },
              "fullDescription": {
                "text": "Constraint-bearing shape without sh:message. Add sh:message to constraint-bearing shapes for better diagnostics."
              },
              "help": {
                "text": "Add sh:message to constraint-bearing shapes for better diagnostics."
              },
              "defaultConfiguration": {
                "level": "note"
