              "id": "METRIC009",
              "name": "METRIC009",
              "shortDescription": {
                "text": "Low label language-tag coverage"
              },
              "fullDescription": {
                "text": "Low label language-tag coverage. Tag labels with their language (for example rdfs:label \"x\"@en)."
              },
              "help": {
                "text": "Tag labels with their language (for example rdfs:label \"x\"@en)."
              },
