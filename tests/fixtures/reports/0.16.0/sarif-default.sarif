              "name": "METRIC013",
              "shortDescription": {
                "text": "High blank node ratio"
              },
              "fullDescription": {
                "text": "High blank node ratio. Check whether anonymous resources could be named, or are restrictions that should be reviewed."
              },
              "help": {
                "text": "Check whether anonymous resources could be named, or are restrictions that should be reviewed."
