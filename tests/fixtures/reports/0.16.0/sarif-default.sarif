              "shortDescription": {
                "text": "Invalid sh:pattern regular expression"
              },
              "fullDescription": {
                "text": "Invalid sh:pattern regular expression. Fix the sh:pattern expression (and sh:flags) so it compiles."
              },
              "help": {
