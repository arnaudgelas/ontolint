                "category": "heuristic",
                "backend": "rdflib",
                "scope": "shapes"
              }
            },
            {
              "id": "SHQ025",
              "name": "SHQ025",
              "shortDescription": {
                "text": "sh:and, sh:or or sh:xone with fewer than two members"
              },
              "fullDescription": {
                "text": "sh:and, sh:or or sh:xone with fewer than two members. Inline the single member or add the missing alternatives; an empty sh:or can never hold."
              },
              "help": {
                "text": "Inline the single member or add the missing alternatives; an empty sh:or can never hold."
              },
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "category": "heuristic",
                "backend": "rdflib",
                "scope": "shapes"
              }
            },
            {
              "id": "SHQ026",
              "name": "SHQ026",
              "shortDescription": {
                "text": "Node shape with several property shapes for the same path"
              },
              "fullDescription": {
                "text": "Node shape with several property shapes for the same path. Merge the property shapes that constrain the same sh:path."
              },
              "help": {
                "text": "Merge the property shapes that constrain the same sh:path."
              },
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "category": "heuristic",
                "backend": "rdflib",
                "scope": "shapes"
              }
            },
            {
              "id": "SHQ027",
              "name": "SHQ027",
              "shortDescription": {
                "text": "Shape targets a local class the ontology does not declare"
              },
              "fullDescription": {
                "text": "Shape targets a local class the ontology does not declare. Fix the sh:targetClass IRI or declare the class in the ontology."
              },
              "help": {
                "text": "Fix the sh:targetClass IRI or declare the class in the ontology."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "category": "heuristic",
                "backend": "rdflib",
                "scope": "shapes"
              }
            },
            {
              "id": "SKOS001",
              "name": "SKOS001",
              "shortDescription": {
                "text": "Multiple preferred labels in one language"
              },
              "fullDescription": {
                "text": "Multiple preferred labels in one language. Keep only one skos:prefLabel per language tag for a given resource."
              },
              "help": {
                "text": "Keep only one skos:prefLabel per language tag for a given resource."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "category": "heuristic",
                "backend": "rdflib",
                "scope": "term"
              }
            },
            {
              "id": "SKOS002",
              "name": "SKOS002",
              "shortDescription": {
                "text": "Same literal in disjoint SKOS label properties"
              },
              "fullDescription": {
                "text": "Same literal in disjoint SKOS label properties. Do not reuse the same literal across prefLabel, altLabel and hiddenLabel of one resource."
              },
              "help": {
                "text": "Do not reuse the same literal across prefLabel, altLabel and hiddenLabel of one resource."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "category": "heuristic",
                "backend": "rdflib",
                "scope": "term"
              }
            },
            {
              "id": "SKOS003",
              "name": "SKOS003",
              "shortDescription": {
                "text": "Cycle in skos:broader hierarchy"
              },
              "fullDescription": {
                "text": "Cycle in skos:broader hierarchy. Inspect hierarchical cycles; SKOS does not universally prohibit them."
              },
              "help": {
                "text": "Inspect hierarchical cycles; SKOS does not universally prohibit them."
              },
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "category": "heuristic",
                "backend": "rdflib",
                "scope": "vocabulary"
              }
            },
            {
              "id": "SKOS004",
              "name": "SKOS004",
              "shortDescription": {
                "text": "Concept without preferred label"
              },
              "fullDescription": {
                "text": "Concept without preferred label. Give a concept a preferred label in your supported language(s)."
              },
              "help": {
                "text": "Give a concept a preferred label in your supported language(s)."
              },
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "category": "heuristic",
                "backend": "rdflib",
                "scope": "term"
              }
            },
            {
              "id": "SKOS005",
              "name": "SKOS005",
              "shortDescription": {
                "text": "Concept not in a concept scheme"
              },
              "fullDescription": {
                "text": "Concept not in a concept scheme. Use skos:Concept with skos:inScheme and an appropriate scheme policy."
              },
              "help": {
                "text": "Use skos:Concept with skos:inScheme and an appropriate scheme policy."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "category": "heuristic",
                "backend": "rdflib",
                "scope": "term"
              }
            },
            {
              "id": "SKOS006",
              "name": "SKOS006",
              "shortDescription": {
                "text": "Top concept with a broader concept"
              },
              "fullDescription": {
                "text": "Top concept with a broader concept. Review whether a scheme top concept should also have a broader concept."
              },
              "help": {
                "text": "Review whether a scheme top concept should also have a broader concept."
              },
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "category": "heuristic",
                "backend": "rdflib",
                "scope": "term"
              }
            },
            {
              "id": "SKOS007",
              "name": "SKOS007",
              "shortDescription": {
                "text": "Resource typed as both skos:Concept and skos:ConceptScheme"
              },
              "fullDescription": {
                "text": "Resource typed as both skos:Concept and skos:ConceptScheme. Split the resource: skos:Concept and skos:ConceptScheme are disjoint classes."
              },
              "help": {
                "text": "Split the resource: skos:Concept and skos:ConceptScheme are disjoint classes."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "category": "deterministic",
                "backend": "rdflib",
                "scope": "term"
              }
            },
            {
              "id": "SKOS008",
              "name": "SKOS008",
              "shortDescription": {
                "text": "skos:Collection typed as concept or concept scheme"
              },
              "fullDescription": {
                "text": "skos:Collection typed as concept or concept scheme. Do not type a skos:Collection as skos:Concept or skos:ConceptScheme; the classes are disjoint."
              },
              "help": {
                "text": "Do not type a skos:Collection as skos:Concept or skos:ConceptScheme; the classes are disjoint."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "category": "deterministic",
                "backend": "rdflib",
                "scope": "term"
              }
            },
            {
              "id": "SKOS009",
              "name": "SKOS009",
              "shortDescription": {
                "text": "skos:related between concepts that are also hierarchically linked"
              },
              "fullDescription": {
                "text": "skos:related between concepts that are also hierarchically linked. Remove skos:related or the broader/narrower link: associative and hierarchical relations are disjoint."
              },
              "help": {
                "text": "Remove skos:related or the broader/narrower link: associative and hierarchical relations are disjoint."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "category": "deterministic",
                "backend": "rdflib",
                "scope": "term"
              }
            },
            {
              "id": "SKOS010",
              "name": "SKOS010",
              "shortDescription": {
                "text": "Concept related to itself"
              },
              "fullDescription": {
                "text": "Concept related to itself. Remove the reflexive skos:related statement."
              },
              "help": {
                "text": "Remove the reflexive skos:related statement."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "category": "deterministic",
                "backend": "rdflib",
                "scope": "term"
              }
            },
            {
              "id": "SKOS011",
              "name": "SKOS011",
              "shortDescription": {
                "text": "SKOS mapping property between concepts of the same scheme"
              },
              "fullDescription": {
                "text": "SKOS mapping property between concepts of the same scheme. Use skos:broader/narrower/related inside a scheme; reserve mapping properties for cross-scheme links."
              },
              "help": {
                "text": "Use skos:broader/narrower/related inside a scheme; reserve mapping properties for cross-scheme links."
              },
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "category": "deterministic",
                "backend": "rdflib",
                "scope": "term"
              }
            },
            {
              "id": "SKOS012",
              "name": "SKOS012",
              "shortDescription": {
                "text": "skos:exactMatch combined with broadMatch, narrowMatch or relatedMatch"
              },
              "fullDescription": {
                "text": "skos:exactMatch combined with broadMatch, narrowMatch or relatedMatch. Keep one mapping type per concept pair: skos:exactMatch is disjoint with broad/narrow/relatedMatch."
              },
              "help": {
                "text": "Keep one mapping type per concept pair: skos:exactMatch is disjoint with broad/narrow/relatedMatch."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "category": "deterministic",
                "backend": "rdflib",
                "scope": "term"
              }
            },
            {
              "id": "SKOS013",
              "name": "SKOS013",
              "shortDescription": {
                "text": "SKOS label that is not a plain or language-tagged string literal"
              },
              "fullDescription": {
                "text": "SKOS label that is not a plain or language-tagged string literal. Use a plain or language-tagged string literal for skos:prefLabel, altLabel and hiddenLabel."
              },
              "help": {
                "text": "Use a plain or language-tagged string literal for skos:prefLabel, altLabel and hiddenLabel."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "category": "deterministic",
                "backend": "rdflib",
                "scope": "term"
              }
            },
            {
              "id": "SKOS014",
              "name": "SKOS014",
              "shortDescription": {
                "text": "SKOS label that is empty or has surrounding whitespace"
              },
              "fullDescription": {
                "text": "SKOS label that is empty or has surrounding whitespace. Trim the label and do not leave it empty."
              },
              "help": {
                "text": "Trim the label and do not leave it empty."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "category": "deterministic",
                "backend": "rdflib",
                "scope": "term"
              }
            },
            {
              "id": "SKOS015",
              "name": "SKOS015",
              "shortDescription": {
                "text": "Concept scheme with concepts but no top concept"
              },
              "fullDescription": {
                "text": "Concept scheme with concepts but no top concept. Declare entry points with skos:hasTopConcept or skos:topConceptOf."
              },
              "help": {
                "text": "Declare entry points with skos:hasTopConcept or skos:topConceptOf."
              },
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "category": "deterministic",
                "backend": "rdflib",
                "scope": "term"
              }
            },
            {
              "id": "SKOS016",
              "name": "SKOS016",
              "shortDescription": {
                "text": "SKOS relation with a literal value"
              },
              "fullDescription": {
                "text": "SKOS relation with a literal value. SKOS semantic, mapping and scheme relations link resources; replace the literal with an IRI."
              },
              "help": {
                "text": "SKOS semantic, mapping and scheme relations link resources; replace the literal with an IRI."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "category": "deterministic",
                "backend": "rdflib",
                "scope": "term"
              }
            },
            {
              "id": "SKOS017",
              "name": "SKOS017",
              "shortDescription": {
                "text": "SKOS relation to an undescribed local resource"
              },
              "fullDescription": {
                "text": "SKOS relation to an undescribed local resource. Describe the target concept in the vocabulary or correct the link."
              },
              "help": {
                "text": "Describe the target concept in the vocabulary or correct the link."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "category": "deterministic",
                "backend": "rdflib",
                "scope": "term"
              }
            },
            {
              "id": "SKOS018",
              "name": "SKOS018",
              "shortDescription": {
                "text": "Redundant skos:broader shortcut"
              },
              "fullDescription": {
                "text": "Redundant skos:broader shortcut. Remove the direct broader link that is already implied through an asserted intermediate concept (vocabularies with a parallel classification keep such shortcuts on purpose: use --ignore SKOS018)."
              },
              "help": {
                "text": "Remove the direct broader link that is already implied through an asserted intermediate concept (vocabularies with a parallel classification keep such shortcuts on purpose: use --ignore SKOS018)."
              },
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "category": "deterministic",
                "backend": "rdflib",
                "scope": "term"
              }
            },
            {
              "id": "SKOS019",
              "name": "SKOS019",
              "shortDescription": {
                "text": "Hierarchical link between concepts of different schemes"
              },
              "fullDescription": {
                "text": "Hierarchical link between concepts of different schemes. Keep broader/narrower inside one scheme and use mapping properties across schemes."
              },
              "help": {
                "text": "Keep broader/narrower inside one scheme and use mapping properties across schemes."
              },
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "category": "deterministic",
                "backend": "rdflib",
                "scope": "term"
              }
            },
            {
              "id": "SKOS020",
              "name": "SKOS020",
              "shortDescription": {
                "text": "Same skos:notation on several concepts of one scheme"
              },
              "fullDescription": {
                "text": "Same skos:notation on several concepts of one scheme. Make notations unique within a concept scheme."
              },
              "help": {
                "text": "Make notations unique within a concept scheme."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "category": "deterministic",
                "backend": "rdflib",
                "scope": "term"
              }
            },
            {
              "id": "SKOS021",
              "name": "SKOS021",
              "shortDescription": {
                "text": "Same preferred label on several concepts of one scheme"
              },
              "fullDescription": {
                "text": "Same preferred label on several concepts of one scheme. Give concepts of one scheme distinguishable preferred labels per language."
              },
              "help": {
                "text": "Give concepts of one scheme distinguishable preferred labels per language."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
