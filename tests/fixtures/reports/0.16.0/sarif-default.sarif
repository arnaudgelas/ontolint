              "id": "SHQ006",
              "name": "SHQ006",
              "shortDescription": {
                "text": "Instantiated class without shape target"
              },
              "fullDescription": {
                "text": "Instantiated class without shape target. Add a shape targeting this class, or exempt it from data-quality validation."
              },
              "help": {
                "text": "Add a shape targeting this class, or exempt it from data-quality validation."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "category": "heuristic",
