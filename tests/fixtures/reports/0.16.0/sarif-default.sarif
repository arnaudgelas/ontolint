              "shortDescription": {
                "text": "sh:in list that is empty or repeats members"
              },
              "fullDescription": {
                "text": "sh:in list that is empty or repeats members. Remove duplicate members; an empty sh:in list can never be satisfied."
              },
              "help": {
                "text": "Remove duplicate members; an empty sh:in list can never be satisfied."
              },
              "defaultConfiguration": {
                "level": "warning"
