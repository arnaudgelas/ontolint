{
  "version": "2.1.0",
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "ontolint",
          "version": "0.16.0",
          "rules": [
            {
              "id": "ALIGN002",
              "name": "ALIGN002",
              "shortDescription": {
                "text": "Misspelt SKOS or OWL mapping predicate"
              },
              "fullDescription": {
                "text": "Misspelt SKOS or OWL mapping predicate. Use the exact SKOS or OWL mapping property IRI (for example skos:exactMatch); the asserted one is unknown."
              },
              "help": {
                "text": "Use the exact SKOS or OWL mapping property IRI (for example skos:exactMatch); the asserted one is unknown."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "category": "heuristic",
                "backend": "rdflib",
                "scope": "term"
              }
            },
            {
              "id": "ALIGN003",
              "name": "ALIGN003",
              "shortDescription": {
                "text": "exactMatch chain conflicting with broadMatch, narrowMatch or relatedMatch"
              },
              "fullDescription": {
                "text": "exactMatch chain conflicting with broadMatch, narrowMatch or relatedMatch. skos:exactMatch is transitive and disjoint with broad/narrowMatch; drop one mapping of the chain."
              },
              "help": {
                "text": "skos:exactMatch is transitive and disjoint with broad/narrowMatch; drop one mapping of the chain."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "category": "deterministic",
                "backend": "rdflib",
                "scope": "term"
              }
            },
            {
              "id": "ALIGN004",
              "name": "ALIGN004",
              "shortDescription": {
                "text": "Contradictory hierarchical or associative mapping strengths"
              },
              "fullDescription": {
                "text": "Contradictory hierarchical or associative mapping strengths. Keep one mapping strength per pair: broadMatch, narrowMatch and relatedMatch exclude each other."
              },
              "help": {
                "text": "Keep one mapping strength per pair: broadMatch, narrowMatch and relatedMatch exclude each other."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "category": "deterministic",
                "backend": "rdflib",
                "scope": "term"
              }
            },
            {
              "id": "ALIGN005",
              "name": "ALIGN005",
              "shortDescription": {
                "text": "Term with several distinct exactMatch targets in one namespace"
              },
              "fullDescription": {
                "text": "Term with several distinct exactMatch targets in one namespace. Keep one exactMatch per target namespace, or relate the targets to each other if they are the same thing."
              },
              "help": {
                "text": "Keep one exactMatch per target namespace, or relate the targets to each other if they are the same thing."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "category": "context-dependent",
                "backend": "rdflib",
                "scope": "term"
              }
            },
            {
              "id": "ALIGN007",
              "name": "ALIGN007",
              "shortDescription": {
                "text": "Symmetric SKOS mapping asserted in one direction only"
              },
              "fullDescription": {
                "text": "Symmetric SKOS mapping asserted in one direction only. Assert the inverse skos:exactMatch/closeMatch too, since both terms are described in this file."
              },
              "help": {
                "text": "Assert the inverse skos:exactMatch/closeMatch too, since both terms are described in this file."
              },
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "category": "context-dependent",
                "backend": "rdflib",
                "scope": "term"
              }
            },
            {
              "id": "ALIGN009",
              "name": "ALIGN009",
              "shortDescription": {
                "text": "Mapping between a class and a property"
              },
              "fullDescription": {
                "text": "Mapping between a class and a property. Map classes to classes and properties to properties; the declared kinds are incompatible."
              },
              "help": {
                "text": "Map classes to classes and properties to properties; the declared kinds are incompatible."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "category": "context-dependent",
                "backend": "rdflib",
                "scope": "term"
              }
            },
            {
              "id": "ALIGN012",
              "name": "ALIGN012",
              "shortDescription": {
                "text": "Mapping target outside the declared alignment namespaces"
              },
              "fullDescription": {
                "text": "Mapping target outside the declared alignment namespaces. Map to a term inside one of alignment_namespaces, or add the target's namespace to the policy file."
              },
              "help": {
                "text": "Map to a term inside one of alignment_namespaces, or add the target's namespace to the policy file."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "category": "deterministic",
                "backend": "rdflib",
                "scope": "term"
              }
            },
            {
              "id": "ALIGN013",
              "name": "ALIGN013",
              "shortDescription": {
                "text": "Duplicate mapping through several predicates"
              },
              "fullDescription": {
                "text": "Duplicate mapping through several predicates. Keep the most precise mapping predicate; the same pair is related by several equivalent assertions."
              },
              "help": {
                "text": "Keep the most precise mapping predicate; the same pair is related by several equivalent assertions."
              },
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "category": "context-dependent",
                "backend": "rdflib",
                "scope": "term"
              }
            },
            {
              "id": "ALIGN014",
              "name": "ALIGN014",
              "shortDescription": {
                "text": "broadMatch or narrowMatch contradicting the asserted hierarchy"
              },
              "fullDescription": {
                "text": "broadMatch or narrowMatch contradicting the asserted hierarchy. Reverse the mapping or fix the hierarchy; the file places the broader term below the narrower one."
              },
              "help": {
                "text": "Reverse the mapping or fix the hierarchy; the file places the broader term below the narrower one."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "category": "deterministic",
                "backend": "rdflib",
                "scope": "term"
              }
            },
            {
              "id": "ALIGN015",
              "name": "ALIGN015",
              "shortDescription": {
                "text": "Declared mapping set without version, creator or licence"
              },
              "fullDescription": {
                "text": "Declared mapping set without version, creator or licence. Add a version, a creator and a licence to the sssom:MappingSet."
              },
              "help": {
                "text": "Add a version, a creator and a licence to the sssom:MappingSet."
              },
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "category": "deterministic",
                "backend": "rdflib",
                "scope": "ontology"
              }
            },
            {
              "id": "ALIGN016",
              "name": "ALIGN016",
              "shortDescription": {
                "text": "Mapping coverage below the expected ratio"
              },
              "fullDescription": {
                "text": "Mapping coverage below the expected ratio. Align more classes and properties (skos:exactMatch, owl:equivalentClass) or lower alignment_min_coverage."
              },
              "help": {
                "text": "Align more classes and properties (skos:exactMatch, owl:equivalentClass) or lower alignment_min_coverage."
              },
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "category": "context-dependent",
                "backend": "rdflib",
                "scope": "ontology"
              }
            },
            {
              "id": "CLS001",
              "name": "CLS001",
              "shortDescription": {
                "text": "Disconnected class"
              },
              "fullDescription": {
                "text": "Disconnected class. Inspect whether the class is intentional: it has no sub/superclass or equivalence link, is not deprecated and is never used as a domain, range, restriction filler or type."
              },
              "help": {
                "text": "Inspect whether the class is intentional: it has no sub/superclass or equivalence link, is not deprecated and is never used as a domain, range, restriction filler or type."
              },
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "category": "heuristic",
                "backend": "rdflib",
                "scope": "term"
              }
            },
            {
              "id": "CLS002",
              "name": "CLS002",
              "shortDescription": {
                "text": "Class without instances or subclasses"
              },
              "fullDescription": {
                "text": "Class without instances or subclasses. Check whether this class is intentionally uninstantiated, abstract, or imported."
              },
              "help": {
                "text": "Check whether this class is intentionally uninstantiated, abstract, or imported."
              },
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "category": "heuristic",
                "backend": "rdflib",
                "scope": "term"
              }
            },
            {
              "id": "CLS003",
              "name": "CLS003",
              "shortDescription": {
                "text": "Asserted subclass cycle"
              },
              "fullDescription": {
                "text": "Asserted subclass cycle. Review the asserted subclass cycle; an OWL subclass cycle is not by itself inconsistent."
              },
              "help": {
                "text": "Review the asserted subclass cycle; an OWL subclass cycle is not by itself inconsistent."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "category": "heuristic",
                "backend": "rdflib",
                "scope": "vocabulary"
              }
            },
            {
              "id": "CLS004",
              "name": "CLS004",
              "shortDescription": {
                "text": "Transitively redundant subclass axiom"
              },
              "fullDescription": {
                "text": "Transitively redundant subclass axiom. Remove a redundant asserted subclass axiom if it adds no documentation value."
              },
              "help": {
                "text": "Remove a redundant asserted subclass axiom if it adds no documentation value."
              },
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "category": "heuristic",
                "backend": "rdflib",
                "scope": "term"
              }
            },
            {
              "id": "CLS005",
              "name": "CLS005",
              "shortDescription": {
                "text": "Excessive hierarchy depth"
              },
              "fullDescription": {
                "text": "Excessive hierarchy depth. Review unusually deep asserted hierarchy and possible re-modeling."
              },
              "help": {
                "text": "Review unusually deep asserted hierarchy and possible re-modeling."
              },
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "category": "heuristic",
                "backend": "rdflib",
                "scope": "term"
              }
            },
            {
              "id": "CLS006",
              "name": "CLS006",
              "shortDescription": {
                "text": "Excessive direct superclasses"
              },
              "fullDescription": {
                "text": "Excessive direct superclasses. Review the intended meaning of multiple direct superclasses."
              },
              "help": {
                "text": "Review the intended meaning of multiple direct superclasses."
              },
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "category": "heuristic",
                "backend": "rdflib",
                "scope": "term"
              }
            },
            {
              "id": "CLS007",
              "name": "CLS007",
              "shortDescription": {
                "text": "Long single-child taxonomic chain"
              },
              "fullDescription": {
                "text": "Long single-child taxonomic chain. Check long single-child taxonomic chains for needless subdivisions."
              },
              "help": {
                "text": "Check long single-child taxonomic chains for needless subdivisions."
              },
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "category": "heuristic",
                "backend": "rdflib",
                "scope": "term"
              }
            },
            {
              "id": "CLS008",
              "name": "CLS008",
              "shortDescription": {
                "text": "Class with excessive asserted properties"
              },
              "fullDescription": {
                "text": "Class with excessive asserted properties. Consider splitting classes or using property groups/shapes where appropriate."
              },
              "help": {
                "text": "Consider splitting classes or using property groups/shapes where appropriate."
              },
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "category": "heuristic",
                "backend": "rdflib",
                "scope": "term"
              }
            },
            {
              "id": "CLS009",
              "name": "CLS009",
              "shortDescription": {
                "text": "Equivalent classes with identical labels"
              },
              "fullDescription": {
                "text": "Equivalent classes with identical labels. Check whether class equivalence is purposeful and not merely a duplicate name."
              },
              "help": {
                "text": "Check whether class equivalence is purposeful and not merely a duplicate name."
              },
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "category": "heuristic",
                "backend": "rdflib",
                "scope": "term"
              }
            },
            {
              "id": "CLS010",
              "name": "CLS010",
              "shortDescription": {
                "text": "Sibling classes with identical labels"
              },
              "fullDescription": {
                "text": "Sibling classes with identical labels. Give each sibling class a distinct label, or merge the classes if they mean the same thing."
              },
              "help": {
                "text": "Give each sibling class a distinct label, or merge the classes if they mean the same thing."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "category": "heuristic",
                "backend": "rdflib",
                "scope": "term"
              }
            },
            {
              "id": "CLS011",
              "name": "CLS011",
              "shortDescription": {
                "text": "Excessive direct subclasses"
              },
              "fullDescription": {
                "text": "Excessive direct subclasses. Introduce intermediate classes to structure a flat fan-out of direct subclasses."
              },
              "help": {
                "text": "Introduce intermediate classes to structure a flat fan-out of direct subclasses."
              },
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "category": "heuristic",
                "backend": "rdflib",
                "scope": "term"
              }
            },
            {
              "id": "CLS012",
              "name": "CLS012",
              "shortDescription": {
                "text": "Instantiated class with only unused leaf subclasses"
              },
              "fullDescription": {
                "text": "Instantiated class with only unused leaf subclasses. Check whether the unused leaf subclasses are needed or whether instances should use them."
              },
              "help": {
                "text": "Check whether the unused leaf subclasses are needed or whether instances should use them."
              },
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "category": "heuristic",
                "backend": "rdflib",
                "scope": "term"
              }
            },
            {
              "id": "CLS013",
              "name": "CLS013",
              "shortDescription": {
                "text": "Miscellaneous remainder class"
              },
              "fullDescription": {
                "text": "Miscellaneous remainder class. Replace the catch-all 'Other' subclass with specific classes or an open-world note on its parent."
              },
              "help": {
                "text": "Replace the catch-all 'Other' subclass with specific classes or an open-world note on its parent."
              },
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "category": "heuristic",
                "backend": "rdflib",
                "scope": "term"
              }
            },
            {
              "id": "CLS014",
              "name": "CLS014",
              "shortDescription": {
                "text": "Class below two asserted-disjoint classes"
              },
              "fullDescription": {
                "text": "Class below two asserted-disjoint classes. Remove one of the superclass assertions or the disjointness; the class cannot have instances."
              },
              "help": {
                "text": "Remove one of the superclass assertions or the disjointness; the class cannot have instances."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "category": "heuristic",
                "backend": "rdflib",
                "scope": "term"
              }
            },
            {
              "id": "CLS015",
              "name": "CLS015",
              "shortDescription": {
                "text": "Unlabelled class with several subclasses"
              },
              "fullDescription": {
                "text": "Unlabelled class with several subclasses. Add an rdfs:label or skos:prefLabel to the class that heads a subtree."
              },
              "help": {
                "text": "Add an rdfs:label or skos:prefLabel to the class that heads a subtree."
              },
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "category": "heuristic",
                "backend": "rdflib",
                "scope": "term"
              }
            },
            {
              "id": "CLS016",
              "name": "CLS016",
              "shortDescription": {
                "text": "Generic is-a style property"
              },
              "fullDescription": {
                "text": "Generic is-a style property. Use rdfs:subClassOf or rdf:type, or a semantically specific property, instead of a generic 'is' property."
              },
              "help": {
                "text": "Use rdfs:subClassOf or rdf:type, or a semantically specific property, instead of a generic 'is' property."
              },
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "category": "heuristic",
                "backend": "rdflib",
                "scope": "term"
              }
            },
            {
              "id": "CLS017",
              "name": "CLS017",
              "shortDescription": {
                "text": "Class also used as an individual"
              },
              "fullDescription": {
                "text": "Class also used as an individual. Check whether the class/individual punning is intended; otherwise model the individual separately."
              },
              "help": {
                "text": "Check whether the class/individual punning is intended; otherwise model the individual separately."
              },
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "category": "heuristic",
                "backend": "rdflib",
                "scope": "term"
              }
            },
            {
              "id": "CLS018",
              "name": "CLS018",
              "shortDescription": {
                "text": "Redundant owl:Thing superclass"
              },
              "fullDescription": {
                "text": "Redundant owl:Thing superclass. Drop the explicit owl:Thing or rdfs:Resource superclass; the class already has another superclass."
              },
              "help": {
                "text": "Drop the explicit owl:Thing or rdfs:Resource superclass; the class already has another superclass."
              },
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "category": "heuristic",
                "backend": "rdflib",
                "scope": "term"
              }
            },
            {
              "id": "CLS019",
              "name": "CLS019",
              "shortDescription": {
                "text": "Class asserted equal to or below owl:Nothing"
              },
              "fullDescription": {
                "text": "Class asserted equal to or below owl:Nothing. Remove the owl:Nothing assertion or the class if it is not meant to be unsatisfiable."
              },
              "help": {
                "text": "Remove the owl:Nothing assertion or the class if it is not meant to be unsatisfiable."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "category": "heuristic",
                "backend": "rdflib",
                "scope": "term"
              }
            },
            {
              "id": "CLS020",
              "name": "CLS020",
              "shortDescription": {
                "text": "Subclass labelled like its superclass"
              },
              "fullDescription": {
                "text": "Subclass labelled like its superclass. Give the subclass a label that says how it specializes its superclass."
              },
              "help": {
                "text": "Give the subclass a label that says how it specializes its superclass."
              },
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "category": "heuristic",
                "backend": "rdflib",
                "scope": "term"
              }
            },
            {
              "id": "CLS021",
              "name": "CLS021",
              "shortDescription": {
                "text": "Equivalent class that is also an asserted ancestor"
              },
              "fullDescription": {
                "text": "Equivalent class that is also an asserted ancestor. Check whether the subclass chain between equivalent classes is intended; it collapses the chain."
              },
              "help": {
                "text": "Check whether the subclass chain between equivalent classes is intended; it collapses the chain."
              },
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "category": "heuristic",
                "backend": "rdflib",
                "scope": "term"
              }
            },
            {
              "id": "CLS022",
              "name": "CLS022",
              "shortDescription": {
                "text": "Class named like a property"
              },
              "fullDescription": {
                "text": "Class named like a property. Name classes with nouns; a has/is-style name usually denotes a property."
              },
              "help": {
                "text": "Name classes with nouns; a has/is-style name usually denotes a property."
              },
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "category": "heuristic",
                "backend": "rdflib",
                "scope": "term"
              }
            },
            {
              "id": "CLS023",
              "name": "CLS023",
              "shortDescription": {
                "text": "Class name encodes a conjunction"
              },
              "fullDescription": {
                "text": "Class name encodes a conjunction. Split the class, or use owl:unionOf / owl:intersectionOf instead of 'And'/'Or' in the name."
              },
              "help": {
                "text": "Split the class, or use owl:unionOf / owl:intersectionOf instead of 'And'/'Or' in the name."
              },
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "category": "heuristic",
                "backend": "rdflib",
                "scope": "term"
              }
            },
            {
              "id": "CLS024",
              "name": "CLS024",
              "shortDescription": {
                "text": "Sibling class breaking the naming pattern"
              },
              "fullDescription": {
                "text": "Sibling class breaking the naming pattern. Check whether the class belongs under this parent or should follow its siblings' naming pattern."
              },
              "help": {
                "text": "Check whether the class belongs under this parent or should follow its siblings' naming pattern."
              },
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "category": "heuristic",
                "backend": "rdflib",
                "scope": "term"
              }
            },
            {
              "id": "CLS025",
              "name": "CLS025",
              "shortDescription": {
                "text": "Instance typed with a class and its ancestor"
              },
              "fullDescription": {
                "text": "Instance typed with a class and its ancestor. Remove the redundant type assertion for the ancestor class."
              },
              "help": {
                "text": "Remove the redundant type assertion for the ancestor class."
              },
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "category": "heuristic",
                "backend": "rdflib",
                "scope": "term"
              }
            },
            {
              "id": "DATA001",
              "name": "DATA001",
              "shortDescription": {
                "text": "Value datatype conflicts with property range"
              },
              "fullDescription": {
                "text": "Value datatype conflicts with property range. Check a property assertion for range/type confusion."
              },
              "help": {
                "text": "Check a property assertion for range/type confusion."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "category": "heuristic",
                "backend": "rdflib",
                "scope": "axiom"
              }
            },
            {
              "id": "DATA002",
              "name": "DATA002",
              "shortDescription": {
                "text": "Property usage conflicts with subject type"
              },
              "fullDescription": {
                "text": "Property usage conflicts with subject type. Check a property assertion for datatype/object-property confusion."
              },
              "help": {
                "text": "Check a property assertion for datatype/object-property confusion."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "category": "heuristic",
                "backend": "rdflib",
                "scope": "axiom"
              }
            },
            {
              "id": "DATA003",
              "name": "DATA003",
              "shortDescription": {
                "text": "Literal whose lexical form is not valid for its datatype"
              },
              "fullDescription": {
                "text": "Literal whose lexical form is not valid for its datatype. Correct the value or its datatype ('2004'^^xsd:gYear, not xsd:date); type plain text as xsd:string."
              },
              "help": {
                "text": "Correct the value or its datatype ('2004'^^xsd:gYear, not xsd:date); type plain text as xsd:string."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "category": "deterministic",
                "backend": "rdflib",
                "scope": "axiom"
              }
            },
            {
              "id": "DATA004",
              "name": "DATA004",
              "shortDescription": {
                "text": "Datatype outside the OWL 2 datatype map"
              },
              "fullDescription": {
                "text": "Datatype outside the OWL 2 datatype map. Use a datatype of the OWL 2 datatype map (xsd:dateTime rather than xsd:date), or rdfs:Literal."
              },
              "help": {
                "text": "Use a datatype of the OWL 2 datatype map (xsd:dateTime rather than xsd:date), or rdfs:Literal."
              },
              "defaultConfiguration": {
