              "id": "SHQ004",
              "name": "SHQ004",
              "shortDescription": {
                "text": "Node shape without label or comment"
              },
              "fullDescription": {
                "text": "Node shape without label or comment. Add label and comment to published node shapes."
              },
              "help": {
                "text": "Add label and comment to published node shapes."
