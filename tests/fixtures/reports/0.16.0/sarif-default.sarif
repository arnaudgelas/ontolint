                "scope": "axiom"
              }
            },
            {
              "id": "OWL002",
              "name": "OWL002",
              "shortDescription": {
                "text": "Undeclared property in domain or range axiom"
              },
              "fullDescription": {
                "text": "Undeclared property in domain or range axiom. Explicitly declare local properties used in schema axioms."
              },
              "help": {
                "text": "Explicitly declare local properties used in schema axioms."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "category": "heuristic",
                "backend": "rdflib",
                "scope": "axiom"
              }
            },
            {
              "id": "OWL003",
              "name": "OWL003",
              "shortDescription": {
                "text": "Property typed as both object and datatype property"
              },
              "fullDescription": {
                "text": "Property typed as both object and datatype property. Do not simultaneously declare a property as both owl:ObjectProperty and owl:DatatypeProperty."
              },
              "help": {
                "text": "Do not simultaneously declare a property as both owl:ObjectProperty and owl:DatatypeProperty."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "category": "heuristic",
                "backend": "rdflib",
                "scope": "axiom"
              }
            },
            {
              "id": "OWL004",
              "name": "OWL004",
              "shortDescription": {
                "text": "Multiple domains or ranges mean intersection"
              },
              "fullDescription": {
                "text": "Multiple domains or ranges mean intersection. Review conjunction semantics of multiple rdfs:domain/rdfs:range; use owl:unionOf if intended."
              },
              "help": {
                "text": "Review conjunction semantics of multiple rdfs:domain/rdfs:range; use owl:unionOf if intended."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "category": "heuristic",
                "backend": "rdflib",
                "scope": "axiom"
              }
            },
            {
              "id": "OWL005",
              "name": "OWL005",
              "shortDescription": {
                "text": "Property without domain"
              },
              "fullDescription": {
                "text": "Property without domain. Consider declaring domain or explaining why a global domain is inappropriate."
              },
              "help": {
                "text": "Consider declaring domain or explaining why a global domain is inappropriate."
              },
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "category": "heuristic",
                "backend": "rdflib",
                "scope": "term"
              }
            },
            {
              "id": "OWL006",
              "name": "OWL006",
              "shortDescription": {
                "text": "Property without range"
              },
              "fullDescription": {
                "text": "Property without range. Consider declaring range or explaining why a global range is inappropriate."
              },
              "help": {
                "text": "Consider declaring range or explaining why a global range is inappropriate."
              },
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "category": "heuristic",
                "backend": "rdflib",
                "scope": "term"
              }
            },
            {
              "id": "OWL007",
              "name": "OWL007",
              "shortDescription": {
                "text": "Property declared inverse of itself"
              },
              "fullDescription": {
                "text": "Property declared inverse of itself. Replace self-inverse modeling with owl:SymmetricProperty when this is intentional."
              },
              "help": {
                "text": "Replace self-inverse modeling with owl:SymmetricProperty when this is intentional."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "category": "heuristic",
                "backend": "rdflib",
                "scope": "axiom"
              }
            },
            {
              "id": "OWL008",
              "name": "OWL008",
              "shortDescription": {
                "text": "Symmetric property also declared with an inverse"
              },
              "fullDescription": {
                "text": "Symmetric property also declared with an inverse. Review redundant or unintended inverse axioms on symmetric properties."
              },
              "help": {
                "text": "Review redundant or unintended inverse axioms on symmetric properties."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "category": "heuristic",
                "backend": "rdflib",
                "scope": "axiom"
              }
            },
            {
              "id": "OWL009",
              "name": "OWL009",
              "shortDescription": {
                "text": "Datatype property with object-property characteristic"
              },
              "fullDescription": {
                "text": "Datatype property with object-property characteristic. Use object properties for owl:inverseOf and symmetric/transitive property semantics."
              },
              "help": {
                "text": "Use object properties for owl:inverseOf and symmetric/transitive property semantics."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "category": "heuristic",
                "backend": "rdflib",
                "scope": "axiom"
              }
            },
            {
              "id": "OWL010",
              "name": "OWL010",
              "shortDescription": {
                "text": "Property chain with fewer than two operands"
              },
              "fullDescription": {
                "text": "Property chain with fewer than two operands. Review an owl:propertyChainAxiom whose RDF list has only one element."
              },
              "help": {
                "text": "Review an owl:propertyChainAxiom whose RDF list has only one element."
              },
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "category": "heuristic",
                "backend": "rdflib",
                "scope": "axiom"
              }
            },
            {
              "id": "OWL011",
              "name": "OWL011",
              "shortDescription": {
                "text": "Universal restriction without existence"
              },
              "fullDescription": {
                "text": "Universal restriction without existence. Check intended allValuesFrom semantics; it does not imply existence of a value."
              },
              "help": {
                "text": "Check intended allValuesFrom semantics; it does not imply existence of a value."
              },
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "category": "heuristic",
                "backend": "rdflib",
                "scope": "axiom"
              }
            },
            {
              "id": "OWL012",
              "name": "OWL012",
              "shortDescription": {
                "text": "Class equivalent to itself"
              },
              "fullDescription": {
                "text": "Class equivalent to itself. Review the use of owl:equivalentClass on the class itself."
              },
              "help": {
                "text": "Review the use of owl:equivalentClass on the class itself."
              },
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "category": "heuristic",
                "backend": "rdflib",
                "scope": "axiom"
              }
            },
            {
              "id": "OWL013",
              "name": "OWL013",
              "shortDescription": {
                "text": "Object property asserted with a literal value"
              },
              "fullDescription": {
                "text": "Object property asserted with a literal value. An object-property assertion should point to a resource, not a literal."
              },
              "help": {
                "text": "An object-property assertion should point to a resource, not a literal."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "category": "heuristic",
                "backend": "rdflib",
                "scope": "axiom"
              }
            },
            {
              "id": "OWL014",
              "name": "OWL014",
              "shortDescription": {
                "text": "Datatype property asserted with a resource value"
              },
              "fullDescription": {
                "text": "Datatype property asserted with a resource value. A datatype-property assertion should point to a literal."
              },
              "help": {
                "text": "A datatype-property assertion should point to a literal."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "category": "heuristic",
                "backend": "rdflib",
                "scope": "axiom"
              }
            },
            {
              "id": "OWL015",
              "name": "OWL015",
              "shortDescription": {
                "text": "Undeclared local predicate"
              },
              "fullDescription": {
                "text": "Undeclared local predicate. Declare a local predicate as a property (or exclude it from schema-only policy)."
              },
              "help": {
                "text": "Declare a local predicate as a property (or exclude it from schema-only policy)."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "category": "heuristic",
                "backend": "rdflib",
                "scope": "axiom"
              }
            },
            {
              "id": "OWL016",
              "name": "OWL016",
              "shortDescription": {
                "text": "Reflexivity characteristic on datatype property"
              },
              "fullDescription": {
                "text": "Reflexivity characteristic on datatype property. Remove owl:ReflexiveProperty/owl:IrreflexiveProperty; they apply to object properties only."
              },
              "help": {
                "text": "Remove owl:ReflexiveProperty/owl:IrreflexiveProperty; they apply to object properties only."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "category": "deterministic",
                "backend": "rdflib",
                "scope": "axiom"
              }
            },
            {
              "id": "OWL017",
              "name": "OWL017",
              "shortDescription": {
                "text": "Property both symmetric and asymmetric"
              },
              "fullDescription": {
                "text": "Property both symmetric and asymmetric. Keep only one of owl:SymmetricProperty and owl:AsymmetricProperty; together they leave the property empty."
              },
              "help": {
                "text": "Keep only one of owl:SymmetricProperty and owl:AsymmetricProperty; together they leave the property empty."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "category": "deterministic",
                "backend": "rdflib",
                "scope": "axiom"
              }
            },
            {
              "id": "OWL018",
              "name": "OWL018",
              "shortDescription": {
                "text": "Reflexive property also irreflexive or asymmetric"
              },
              "fullDescription": {
                "text": "Reflexive property also irreflexive or asymmetric. Remove the contradictory characteristic; a reflexive property cannot be irreflexive or asymmetric."
              },
              "help": {
                "text": "Remove the contradictory characteristic; a reflexive property cannot be irreflexive or asymmetric."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "category": "deterministic",
                "backend": "rdflib",
                "scope": "axiom"
              }
            },
            {
              "id": "OWL019",
              "name": "OWL019",
              "shortDescription": {
                "text": "Non-simple property in simple-property axiom"
              },
              "fullDescription": {
                "text": "Non-simple property in simple-property axiom. Drop functional, inverse-functional, irreflexive or asymmetric from transitive or chain-defined properties."
              },
              "help": {
                "text": "Drop functional, inverse-functional, irreflexive or asymmetric from transitive or chain-defined properties."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "category": "deterministic",
                "backend": "rdflib",
                "scope": "axiom"
              }
            },
            {
              "id": "OWL020",
              "name": "OWL020",
              "shortDescription": {
                "text": "Property subPropertyOf cycle"
              },
              "fullDescription": {
                "text": "Property subPropertyOf cycle. Break the owl:subPropertyOf cycle or replace it with owl:equivalentProperty if the properties are equivalent."
              },
              "help": {
                "text": "Break the owl:subPropertyOf cycle or replace it with owl:equivalentProperty if the properties are equivalent."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "category": "deterministic",
                "backend": "rdflib",
                "scope": "axiom"
              }
            },
            {
              "id": "OWL021",
              "name": "OWL021",
              "shortDescription": {
                "text": "Sub-property or equivalent property of a different kind"
              },
              "fullDescription": {
                "text": "Sub-property or equivalent property of a different kind. Relate object properties only to object properties and datatype properties only to datatype properties."
              },
              "help": {
                "text": "Relate object properties only to object properties and datatype properties only to datatype properties."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "category": "deterministic",
                "backend": "rdflib",
                "scope": "axiom"
              }
            },
            {
              "id": "OWL022",
              "name": "OWL022",
              "shortDescription": {
                "text": "Property range conflicts with property kind"
              },
              "fullDescription": {
                "text": "Property range conflicts with property kind. Use datatype ranges for datatype properties and class ranges for object properties."
              },
              "help": {
                "text": "Use datatype ranges for datatype properties and class ranges for object properties."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "category": "deterministic",
                "backend": "rdflib",
                "scope": "axiom"
              }
            },
            {
              "id": "OWL023",
              "name": "OWL023",
              "shortDescription": {
                "text": "Property with several distinct inverses"
              },
              "fullDescription": {
                "text": "Property with several distinct inverses. Review owl:inverseOf axioms; distinct inverses of one property are equivalent to each other."
              },
              "help": {
                "text": "Review owl:inverseOf axioms; distinct inverses of one property are equivalent to each other."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "category": "deterministic",
                "backend": "rdflib",
                "scope": "axiom"
              }
            },
            {
              "id": "OWL024",
              "name": "OWL024",
              "shortDescription": {
                "text": "Disjoint properties that are sub-property or equivalent"
              },
              "fullDescription": {
                "text": "Disjoint properties that are sub-property or equivalent. Remove the disjointness or the sub-property/equivalence axiom; the property can have no assertions."
              },
              "help": {
                "text": "Remove the disjointness or the sub-property/equivalence axiom; the property can have no assertions."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "category": "deterministic",
                "backend": "rdflib",
                "scope": "axiom"
              }
            },
            {
              "id": "OWL025",
              "name": "OWL025",
              "shortDescription": {
                "text": "Disjoint classes that are subclass or equivalent"
              },
              "fullDescription": {
                "text": "Disjoint classes that are subclass or equivalent. Remove the disjointness or the subclass/equivalence axiom; the class cannot have instances."
              },
              "help": {
                "text": "Remove the disjointness or the subclass/equivalence axiom; the class cannot have instances."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "category": "deterministic",
                "backend": "rdflib",
                "scope": "axiom"
              }
            },
            {
              "id": "OWL026",
              "name": "OWL026",
              "shortDescription": {
                "text": "Individuals both same and different"
              },
              "fullDescription": {
                "text": "Individuals both same and different. Remove either the owl:sameAs or the owl:differentFrom assertion; the ontology is inconsistent."
              },
              "help": {
                "text": "Remove either the owl:sameAs or the owl:differentFrom assertion; the ontology is inconsistent."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "category": "deterministic",
                "backend": "rdflib",
                "scope": "axiom"
              }
            },
            {
              "id": "OWL027",
              "name": "OWL027",
              "shortDescription": {
                "text": "Negative property assertion contradicts a positive assertion"
              },
              "fullDescription": {
                "text": "Negative property assertion contradicts a positive assertion. Remove the NegativePropertyAssertion or the contradicting positive triple."
              },
              "help": {
                "text": "Remove the NegativePropertyAssertion or the contradicting positive triple."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "category": "deterministic",
                "backend": "rdflib",
                "scope": "axiom"
              }
            },
            {
              "id": "OWL028",
              "name": "OWL028",
              "shortDescription": {
                "text": "Irreflexive property used reflexively"
              },
              "fullDescription": {
                "text": "Irreflexive property used reflexively. Remove the assertion relating an individual to itself or drop owl:IrreflexiveProperty."
              },
              "help": {
                "text": "Remove the assertion relating an individual to itself or drop owl:IrreflexiveProperty."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "category": "deterministic",
                "backend": "rdflib",
                "scope": "axiom"
              }
            },
            {
              "id": "OWL029",
              "name": "OWL029",
              "shortDescription": {
                "text": "Asymmetric property asserted in both directions"
              },
              "fullDescription": {
                "text": "Asymmetric property asserted in both directions. Remove one direction (or a self-assertion) or drop owl:AsymmetricProperty."
              },
              "help": {
                "text": "Remove one direction (or a self-assertion) or drop owl:AsymmetricProperty."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "category": "deterministic",
                "backend": "rdflib",
                "scope": "axiom"
              }
            },
            {
              "id": "OWL030",
              "name": "OWL030",
              "shortDescription": {
                "text": "Illegal punning of declaration kinds"
              },
              "fullDescription": {
                "text": "Illegal punning of declaration kinds. Do not declare one IRI as both class and datatype, or as annotation property and object/datatype property."
              },
              "help": {
                "text": "Do not declare one IRI as both class and datatype, or as annotation property and object/datatype property."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "category": "deterministic",
                "backend": "rdflib",
                "scope": "term"
              }
            },
            {
              "id": "OWL031",
              "name": "OWL031",
              "shortDescription": {
                "text": "Malformed or empty class-expression list"
              },
              "fullDescription": {
                "text": "Malformed or empty class-expression list. Give owl:unionOf, owl:intersectionOf, owl:oneOf and owl:disjointUnionOf a well-formed, non-empty RDF list."
              },
              "help": {
                "text": "Give owl:unionOf, owl:intersectionOf, owl:oneOf and owl:disjointUnionOf a well-formed, non-empty RDF list."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "category": "deterministic",
                "backend": "rdflib",
                "scope": "axiom"
              }
            },
            {
              "id": "OWL032",
              "name": "OWL032",
              "shortDescription": {
                "text": "Single-operand union, intersection or disjoint union"
              },
              "fullDescription": {
                "text": "Single-operand union, intersection or disjoint union. Replace an owl:unionOf or owl:intersectionOf with one operand by that operand."
              },
              "help": {
                "text": "Replace an owl:unionOf or owl:intersectionOf with one operand by that operand."
              },
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "category": "deterministic",
                "backend": "rdflib",
                "scope": "axiom"
              }
            },
            {
              "id": "OWL033",
              "name": "OWL033",
              "shortDescription": {
                "text": "Duplicate operand in class-expression list"
              },
              "fullDescription": {
                "text": "Duplicate operand in class-expression list. Remove the repeated member from the owl:unionOf, owl:intersectionOf or owl:oneOf list."
              },
              "help": {
                "text": "Remove the repeated member from the owl:unionOf, owl:intersectionOf or owl:oneOf list."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "category": "deterministic",
                "backend": "rdflib",
                "scope": "axiom"
              }
            },
            {
              "id": "OWL034",
              "name": "OWL034",
              "shortDescription": {
                "text": "Restriction with missing or invalid owl:onProperty"
              },
              "fullDescription": {
                "text": "Restriction with missing or invalid owl:onProperty. Give every owl:Restriction exactly one owl:onProperty (or owl:onProperties) pointing to a property."
              },
              "help": {
                "text": "Give every owl:Restriction exactly one owl:onProperty (or owl:onProperties) pointing to a property."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "category": "deterministic",
                "backend": "rdflib",
                "scope": "axiom"
              }
            },
            {
              "id": "OWL035",
              "name": "OWL035",
              "shortDescription": {
                "text": "Restriction without exactly one valid constraint"
              },
              "fullDescription": {
                "text": "Restriction without exactly one valid constraint. Add an owl:someValuesFrom, owl:allValuesFrom, owl:hasValue, owl:hasSelf or cardinality constraint."
              },
              "help": {
                "text": "Add an owl:someValuesFrom, owl:allValuesFrom, owl:hasValue, owl:hasSelf or cardinality constraint."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "category": "deterministic",
                "backend": "rdflib",
                "scope": "axiom"
              }
            },
            {
              "id": "OWL036",
              "name": "OWL036",
              "shortDescription": {
                "text": "Invalid cardinality restriction"
              },
              "fullDescription": {
                "text": "Invalid cardinality restriction. Use a non-negative integer for cardinalities and add owl:onClass/owl:onDataRange to qualified ones."
              },
              "help": {
                "text": "Use a non-negative integer for cardinalities and add owl:onClass/owl:onDataRange to qualified ones."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "category": "deterministic",
                "backend": "rdflib",
                "scope": "axiom"
              }
            },
            {
              "id": "OWL037",
              "name": "OWL037",
              "shortDescription": {
                "text": "Minimum cardinality exceeds maximum cardinality"
              },
              "fullDescription": {
                "text": "Minimum cardinality exceeds maximum cardinality. Make the lower cardinality bound at most the upper bound within one restriction."
              },
              "help": {
                "text": "Make the lower cardinality bound at most the upper bound within one restriction."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "category": "deterministic",
                "backend": "rdflib",
                "scope": "axiom"
              }
            },
            {
              "id": "OWL038",
              "name": "OWL038",
              "shortDescription": {
                "text": "Existential restriction on owl:Nothing"
              },
              "fullDescription": {
                "text": "Existential restriction on owl:Nothing. Remove the restriction or use a satisfiable filler; no individual can be an instance of owl:Nothing."
              },
              "help": {
                "text": "Remove the restriction or use a satisfiable filler; no individual can be an instance of owl:Nothing."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "category": "deterministic",
                "backend": "rdflib",
                "scope": "axiom"
              }
            },
            {
              "id": "OWL039",
              "name": "OWL039",
              "shortDescription": {
                "text": "Vacuous restriction"
              },
              "fullDescription": {
                "text": "Vacuous restriction. Remove a restriction that every individual satisfies (allValuesFrom owl:Thing, minimum cardinality 0)."
              },
              "help": {
                "text": "Remove a restriction that every individual satisfies (allValuesFrom owl:Thing, minimum cardinality 0)."
              },
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "category": "deterministic",
                "backend": "rdflib",
                "scope": "axiom"
              }
            },
            {
              "id": "OWL040",
              "name": "OWL040",
              "shortDescription": {
                "text": "Restriction mixes object and datatype property kinds"
              },
              "fullDescription": {
                "text": "Restriction mixes object and datatype property kinds. Use class fillers and resources with object properties, and datatypes and literals with datatype properties."
              },
              "help": {
                "text": "Use class fillers and resources with object properties, and datatypes and literals with datatype properties."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "category": "deterministic",
                "backend": "rdflib",
                "scope": "axiom"
              }
            },
            {
              "id": "OWL041",
              "name": "OWL041",
              "shortDescription": {
                "text": "Contradictory owl:complementOf cycle"
              },
              "fullDescription": {
                "text": "Contradictory owl:complementOf cycle. Break the odd-length owl:complementOf cycle; a class cannot be the complement of itself."
              },
              "help": {
                "text": "Break the odd-length owl:complementOf cycle; a class cannot be the complement of itself."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "category": "deterministic",
                "backend": "rdflib",
                "scope": "axiom"
              }
            },
            {
              "id": "OWL042",
              "name": "OWL042",
              "shortDescription": {
                "text": "Class subclass of or equivalent to its own complement"
              },
              "fullDescription": {
                "text": "Class subclass of or equivalent to its own complement. Remove the axiom relating a class to its own owl:complementOf expression."
              },
              "help": {
                "text": "Remove the axiom relating a class to its own owl:complementOf expression."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "category": "deterministic",
                "backend": "rdflib",
                "scope": "axiom"
              }
            },
            {
              "id": "OWL043",
              "name": "OWL043",
              "shortDescription": {
                "text": "Contradictory or tautological operands in union or intersection"
              },
              "fullDescription": {
                "text": "Contradictory or tautological operands in union or intersection. Review an intersection of complements/disjoint classes or a union of a class and its complement."
              },
              "help": {
                "text": "Review an intersection of complements/disjoint classes or a union of a class and its complement."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "category": "deterministic",
                "backend": "rdflib",
                "scope": "axiom"
              }
            },
            {
              "id": "OWL044",
              "name": "OWL044",
              "shortDescription": {
                "text": "Individuals identical through owl:sameAs chains but asserted different"
              },
              "fullDescription": {
                "text": "Individuals identical through owl:sameAs chains but asserted different. Remove the conflicting owl:sameAs or owl:differentFrom assertion; nothing differs from itself."
              },
              "help": {
                "text": "Remove the conflicting owl:sameAs or owl:differentFrom assertion; nothing differs from itself."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "category": "deterministic",
                "backend": "rdflib",
                "scope": "axiom"
              }
            },
            {
              "id": "OWL045",
              "name": "OWL045",
              "shortDescription": {
                "text": "Malformed owl:AllDifferent or owl:AllDisjointClasses"
              },
              "fullDescription": {
                "text": "Malformed owl:AllDifferent or owl:AllDisjointClasses. Give the axiom one well-formed member list with at least two distinct members."
              },
              "help": {
                "text": "Give the axiom one well-formed member list with at least two distinct members."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "category": "deterministic",
                "backend": "rdflib",
                "scope": "axiom"
              }
            },
            {
              "id": "SEC004",
              "name": "SEC004",
              "shortDescription": {
                "text": "Deeply nested or very long blank-node structure"
              },
              "fullDescription": {
                "text": "Deeply nested or very long blank-node structure. Flatten the structure or give intermediate nodes IRIs; recursive consumers can exhaust their stack on it."
              },
              "help": {
                "text": "Flatten the structure or give intermediate nodes IRIs; recursive consumers can exhaust their stack on it."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "category": "deterministic",
                "backend": "rdflib",
                "scope": "input"
              }
            },
            {
              "id": "SEC005",
              "name": "SEC005",
              "shortDescription": {
                "text": "Unreasonably large literal value"
              },
              "fullDescription": {
                "text": "Unreasonably large literal value. Store large payloads outside the ontology and reference them by IRI."
              },
              "help": {
                "text": "Store large payloads outside the ontology and reference them by IRI."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "category": "deterministic",
                "backend": "rdflib",
                "scope": "input"
              }
            },
            {
              "id": "SEC007",
              "name": "SEC007",
              "shortDescription": {
                "text": "owl:imports not followed"
              },
              "fullDescription": {
                "text": "owl:imports not followed. Map the imports to local files with --follow-imports and a catalog-v001.xml (or --catalog), or put local copies in a folder (for example with robot mirror) and pass --import-dir; ontolint never fetches imports from the network. Use --ignore SEC007 to silence this note."
              },
              "help": {
                "text": "Map the imports to local files with --follow-imports and a catalog-v001.xml (or --catalog), or put local copies in a folder (for example with robot mirror) and pass --import-dir; ontolint never fetches imports from the network. Use --ignore SEC007 to silence this note."
              },
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "category": "deterministic",
                "backend": "rdflib",
                "scope": "ontology"
              }
            },
            {
              "id": "SEC008",
              "name": "SEC008",
              "shortDescription": {
                "text": "IRI with an unsafe scheme"
              },
              "fullDescription": {
                "text": "IRI with an unsafe scheme. Use http(s), urn or another resolvable-by-design scheme instead of file:, javascript:, data: or similar."
              },
              "help": {
                "text": "Use http(s), urn or another resolvable-by-design scheme instead of file:, javascript:, data: or similar."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "category": "deterministic",
                "backend": "rdflib",
                "scope": "input"
              }
            },
            {
              "id": "SEC012",
              "name": "SEC012",
              "shortDescription": {
                "text": "Control or bidirectional-override characters"
              },
              "fullDescription": {
                "text": "Control or bidirectional-override characters. Remove control and bidirectional-override characters; they can disguise the text a reader sees."
              },
              "help": {
                "text": "Remove control and bidirectional-override characters; they can disguise the text a reader sees."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "category": "deterministic",
                "backend": "rdflib",
                "scope": "input"
              }
            },
            {
              "id": "SEC014",
              "name": "SEC014",
              "shortDescription": {
                "text": "Credentials embedded in an IRI"
              },
              "fullDescription": {
                "text": "Credentials embedded in an IRI. Remove the user:password@ part of the IRI and rotate the exposed credential; the report masks it, so find it at the SARIF region or in the source."
              },
              "help": {
                "text": "Remove the user:password@ part of the IRI and rotate the exposed credential; the report masks it, so find it at the SARIF region or in the source."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "category": "deterministic",
                "backend": "rdflib",
                "scope": "input"
              }
            },
            {
              "id": "SEC016",
              "name": "SEC016",
              "shortDescription": {
                "text": "User name embedded in an IRI"
              },
              "fullDescription": {
                "text": "User name embedded in an IRI. Remove the user@ part of the IRI; if it is a token, rotate it and keep it out of the ontology. The report masks it, so find it at the SARIF region or in the source."
              },
              "help": {
                "text": "Remove the user@ part of the IRI; if it is a token, rotate it and keep it out of the ontology. The report masks it, so find it at the SARIF region or in the source."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "category": "context-dependent",
                "backend": "rdflib",
                "scope": "input"
              }
            },
            {
              "id": "SEM001",
              "name": "SEM001",
              "shortDescription": {
                "text": "OWL profile violation reported by ROBOT"
              },
              "fullDescription": {
                "text": "OWL profile violation reported by ROBOT. Correct the reported OWL profile violations, or select the intended OWL profile."
              },
              "help": {
                "text": "Correct the reported OWL profile violations, or select the intended OWL profile."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "category": "deterministic",
                "backend": "robot-docker",
                "scope": "ontology"
              }
            },
            {
              "id": "SHACL001",
              "name": "SHACL001",
              "shortDescription": {
                "text": "SHACL validation violation"
              },
              "fullDescription": {
                "text": "SHACL validation violation. Fix the supplied SHACL shapes or data, and inspect the SHACL report."
              },
              "help": {
                "text": "Fix the supplied SHACL shapes or data, and inspect the SHACL report."
              },
              "defaultConfiguration": {
