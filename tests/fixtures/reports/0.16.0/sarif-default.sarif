              "id": "METRIC005",
              "name": "METRIC005",
              "shortDescription": {
                "text": "High orphan class ratio"
              },
              "fullDescription": {
                "text": "High orphan class ratio. Connect orphan classes to the hierarchy, properties or instances, or remove them."
              },
              "help": {
                "text": "Connect orphan classes to the hierarchy, properties or instances, or remove them."
              },
              "defaultConfiguration": {
                "level": "note"
              },
