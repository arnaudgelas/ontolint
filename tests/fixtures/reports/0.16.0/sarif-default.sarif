              "fullDescription": {
                "text": "Property shape without sh:description. Add sh:description to non-trivial property shapes."
              },
              "help": {
                "text": "Add sh:description to non-trivial property shapes."
              },
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "category": "heuristic",
