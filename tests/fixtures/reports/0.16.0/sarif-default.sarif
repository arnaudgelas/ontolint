              "id": "METRIC002",
              "name": "METRIC002",
              "shortDescription": {
                "text": "Low class definition coverage"
              },
              "fullDescription": {
                "text": "Low class definition coverage. Add rdfs:comment, skos:definition or dcterms:description to the undefined classes."
              },
              "help": {
                "text": "Add rdfs:comment, skos:definition or dcterms:description to the undefined classes."
              },
