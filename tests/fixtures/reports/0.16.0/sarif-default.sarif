              },
              "help": {
                "text": "Correct the catalog entry (or the owl:imports IRI) so the file declares the imported IRI, or give the file that ontology or version IRI."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "category": "deterministic",
                "backend": "rdflib",
                "scope": "ontology"
              }
            },
            {
              "id": "OWL001",
              "name": "OWL001",
              "shortDescription": {
                "text": "Undeclared class in subclass axiom"
              },
              "fullDescription": {
                "text": "Undeclared class in subclass axiom. Explicitly declare local classes used in class axioms."
              },
              "help": {
                "text": "Explicitly declare local classes used in class axioms."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
