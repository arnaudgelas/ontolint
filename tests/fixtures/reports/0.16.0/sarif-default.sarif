              "id": "METRIC010",
              "name": "METRIC010",
              "shortDescription": {
                "text": "High cross-namespace reference ratio"
              },
              "fullDescription": {
                "text": "High cross-namespace reference ratio. Check that the ontology is not mostly a thin layer over external vocabularies; consider importing instead."
              },
              "help": {
                "text": "Check that the ontology is not mostly a thin layer over external vocabularies; consider importing instead."
              },
              "defaultConfiguration": {
                "level": "note"
              },
