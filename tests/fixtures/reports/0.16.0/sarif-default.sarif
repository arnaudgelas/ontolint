                "scope": "shapes"
              }
            },
            {
              "id": "SHQ007",
              "name": "SHQ007",
              "shortDescription": {
                "text": "Shape with sh:minCount greater than sh:maxCount"
              },
              "fullDescription": {
                "text": "Shape with sh:minCount greater than sh:maxCount. Make sh:minCount <= sh:maxCount."
              },
              "help": {
                "text": "Make sh:minCount <= sh:maxCount."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "category": "deterministic",
