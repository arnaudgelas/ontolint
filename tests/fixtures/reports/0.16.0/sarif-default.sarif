              "fullDescription": {
                "text": "Cardinality or length value is not a non-negative xsd:integer. Use a non-negative xsd:integer."
              },
              "help": {
                "text": "Use a non-negative xsd:integer."
              },
              "defaultConfiguration": {
                "level": "error"
