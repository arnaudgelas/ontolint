              "id": "SHQ012",
              "name": "SHQ012",
              "shortDescription": {
                "text": "sh:uniqueLang on a shape with a non-language-tagged datatype or outside a property shape"
              },
              "fullDescription": {
                "text": "sh:uniqueLang on a shape with a non-language-tagged datatype or outside a property shape. Drop sh:uniqueLang or use sh:datatype rdf:langString; other datatypes never carry a language tag. Put sh:uniqueLang in a property shape (one with sh:path)."
              },
              "help": {
                "text": "Drop sh:uniqueLang or use sh:datatype rdf:langString; other datatypes never carry a language tag. Put sh:uniqueLang in a property shape (one with sh:path)."
