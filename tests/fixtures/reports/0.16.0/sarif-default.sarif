            {
              "id": "METRIC001",
              "name": "METRIC001",
              "shortDescription": {
                "text": "Low class label coverage"
              },
              "fullDescription": {
                "text": "Low class label coverage. Add an rdfs:label or skos:prefLabel to the unlabelled classes."
              },
              "help": {
                "text": "Add an rdfs:label or skos:prefLabel to the unlabelled classes."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "category": "heuristic",
                "backend": "rdflib",
                "scope": "ontology"
              }
            },
