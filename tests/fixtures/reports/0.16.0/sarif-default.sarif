              "id": "METRIC012",
              "name": "METRIC012",
              "shortDescription": {
                "text": "Terse class definitions"
              },
              "fullDescription": {
                "text": "Terse class definitions. Expand very short class definitions so that they state what distinguishes the class."
              },
              "help": {
                "text": "Expand very short class definitions so that they state what distinguishes the class."
