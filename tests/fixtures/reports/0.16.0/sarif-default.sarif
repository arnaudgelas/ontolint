              },
              "fullDescription": {
                "text": "sh:languageIn with a malformed language tag. List well-formed BCP 47 language tags as plain literals, for example \"en\" or \"fr-CA\"."
              },
              "help": {
                "text": "List well-formed BCP 47 language tags as plain literals, for example \"en\" or \"fr-CA\"."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
