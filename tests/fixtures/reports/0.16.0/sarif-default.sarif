              "id": "METRIC008",
              "name": "METRIC008",
              "shortDescription": {
                "text": "Low property signature coverage"
              },
              "fullDescription": {
                "text": "Low property signature coverage. Declare rdfs:domain or rdfs:range on object and datatype properties where the intent is clear."
              },
              "help": {
                "text": "Declare rdfs:domain or rdfs:range on object and datatype properties where the intent is clear."
              },
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "category": "heuristic",
                "backend": "rdflib",
                "scope": "ontology"
