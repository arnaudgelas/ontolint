              "id": "METRIC003",
              "name": "METRIC003",
              "shortDescription": {
                "text": "Low property documentation coverage"
              },
              "fullDescription": {
                "text": "Low property documentation coverage. Document properties with rdfs:comment, skos:definition or dcterms:description."
              },
              "help": {
                "text": "Document properties with rdfs:comment, skos:definition or dcterms:description."
              },
