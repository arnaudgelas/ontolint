              "id": "METRIC007",
              "name": "METRIC007",
              "shortDescription": {
                "text": "High property-to-class ratio"
              },
              "fullDescription": {
                "text": "High property-to-class ratio. Check for property proliferation: generalise properties or add the classes they should describe."
              },
              "help": {
                "text": "Check for property proliferation: generalise properties or add the classes they should describe."
              },
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "category": "heuristic",
                "backend": "rdflib",
                "scope": "ontology"
              }
            },
