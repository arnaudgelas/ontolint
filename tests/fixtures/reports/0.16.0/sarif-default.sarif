              "id": "METRIC004",
              "name": "METRIC004",
              "shortDescription": {
                "text": "High mean class fan-out"
              },
              "fullDescription": {
                "text": "High mean class fan-out. Introduce intermediate classes where parents have many direct subclasses on average."
              },
