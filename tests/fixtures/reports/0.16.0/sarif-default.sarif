              "shortDescription": {
                "text": "Property shape without sh:name"
              },
              "fullDescription": {
                "text": "Property shape without sh:name. Add sh:name to property shapes to support generated forms and documentation."
              },
              "help": {
                "text": "Add sh:name to property shapes to support generated forms and documentation."
