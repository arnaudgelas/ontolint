              "id": "METRIC006",
              "name": "METRIC006",
              "shortDescription": {
                "text": "Low property-to-class ratio"
              },
              "fullDescription": {
                "text": "Low property-to-class ratio. Check whether relations between the classes are missing; the ontology may be only a taxonomy."
              },
              "help": {
                "text": "Check whether relations between the classes are missing; the ontology may be only a taxonomy."
              },
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "category": "heuristic",
                "backend": "rdflib",
                "scope": "ontology"
              }
            },
