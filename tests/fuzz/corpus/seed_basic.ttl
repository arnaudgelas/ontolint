@prefix : <http://example.org/onto#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
<http://example.org/onto> a owl:Ontology ; rdfs:label "Example"@en ; owl:imports <http://127.0.0.1:9/imported> .
:A a owl:Class ; rdfs:label "A"@en, "Un"@fr ; rdfs:comment """multi
line "quoted" comment""" ; rdfs:subClassOf :B, [ a owl:Restriction ; owl:onProperty :p ; owl:someValuesFrom :C ] .
:B a owl:Class ; owl:equivalentClass [ owl:unionOf ( :A :C :D ) ] .
:C a owl:Class ; rdfs:subClassOf :A .
:D a owl:Class ; owl:disjointWith :C .
:p a owl:ObjectProperty ; rdfs:domain :A ; rdfs:range :B ; owl:inverseOf :q .
:q a owl:ObjectProperty .
:n a owl:DatatypeProperty ; rdfs:range xsd:integer .
:i a :A ; :n 42, 3.14, 1e3, true, "x"^^xsd:string, "é\t\\" .
:c a skos:Concept ; skos:prefLabel "c"@en ; skos:broader :c , :c2 .
:c2 a skos:Concept .
_:b1 :p _:b1 .
() :p ( ( 1 ) [ ] ) .
